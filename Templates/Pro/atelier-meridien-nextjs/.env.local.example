# ---- Sanity (obligatoire) ----
# À récupérer sur https://www.sanity.io/manage après création du projet
# (ou via `npx sanity init` depuis ce dossier, qui remplit ces valeurs pour vous)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token "Editor" ou "Viewer + Deploy Studio" — nécessaire pour /studio et pour le script de seed
SANITY_API_TOKEN=

# ---- Brevo (newsletter — recommandé) ----
BREVO_API_KEY=
BREVO_LIST_ID=

# ---- SMTP (formulaire de contact + repli newsletter si Brevo absent) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Site Atelier Méridien" <no-reply@example.com>
MAIL_TO=contact@atelier-meridien.fr

ALLOWED_ORIGIN=*

# ---- Adresse finale du site (optionnel mais recommandé) ----
# Utilisée pour le sitemap, robots.txt et les données structurées.
NEXT_PUBLIC_SITE_URL=https://www.votredomaine.fr

# ---- Google Analytics (optionnel) ----
# Measurement ID (format G-XXXXXXX), voir Guide-Google-Analytics.pdf
NEXT_PUBLIC_GA_ID=

# ---- Google Search Console (optionnel) ----
# Code de vérification "balise HTML" fourni par Search Console
GOOGLE_SITE_VERIFICATION=

# ---- Avis Google (optionnel) ----
# Le Place ID se configure dans Réglages du site → Conversion (Sanity), pas ici.
# Clé API Google Cloud avec "Places API (New)" activée — reste côté serveur.
GOOGLE_PLACES_API_KEY=
