# ---- Sanity (obligatoire) ----
# À récupérer sur https://www.sanity.io/manage après création du projet
# (ou via `npx sanity init` depuis ce dossier, qui remplit ces valeurs pour vous)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token "Editor" ou "Viewer + Deploy Studio" — nécessaire pour /studio et pour le script de seed
SANITY_API_TOKEN=

# ---- Brevo (newsletter — recommandé) ----
BREVO_API_KEY=
BREVO_LIST_ID=

# ---- SMTP (formulaire de contact + repli newsletter si Brevo absent) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Site Atelier Méridien" <no-reply@example.com>
MAIL_TO=contact@atelier-meridien.fr

ALLOWED_ORIGIN=*
